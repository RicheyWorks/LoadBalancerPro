<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://www.w3.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.richmond423</groupId>
    <artifactId>LoadBalancerPro</artifactId>
    <version>2.5.0</version>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <tomcat.version>10.1.55</tomcat.version>
        <netty.version>4.2.17.Final</netty.version>
        <jackson.version>2.22.1</jackson.version>
        <aws-sdk-v2.version>2.51.0</aws-sdk-v2.version>
        <mockito.version>5.17.0</mockito.version>
        <jacoco.version>0.8.15</jacoco.version>
        <argLine></argLine>
    </properties>

    <!-- Centralize framework and security-sensitive dependency families -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk-v2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Spring Boot Web (includes Jackson correctly) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.17</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!-- Optional JSON libs (NOT Jackson, Spring handles that) -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20251224</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>

        <!-- Utilities -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.4</version>
        </dependency>

        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- AWS SDK v2 clients used by the guarded CloudManager integration. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>autoscaling</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <proc>none</proc>
                </configuration>
            </plugin>

            <!-- Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>

            <!-- Optional local operator launcher recipes. No execution is bound to the default lifecycle. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>

            <!-- Test coverage reporting. Reports are generated under target/site/jacoco during verify. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JAR metadata used by the executable Spring Boot artifact. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <!-- The default artifact is the deployable proxy. Simulation and lab tooling are opt-in. -->
                    <includes>
                        <include>META-INF/build-info.properties</include>
                        <include>application.properties</include>
                        <include>application-local.properties</include>
                        <include>application-prod.properties</include>
                        <include>application-proxy-prod.properties</include>
                        <include>static/proxy-status.html</include>
                        <include>com/richmond423/loadbalancerpro/api/LoadBalancerApiApplication*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/ApiErrorResponse*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/RestExceptionHandler*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/ApiRateLimit*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/ApiKeyVerifier*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/ApiSecurityConfiguration*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/AuthModeConfiguration*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/AuthProperties*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/ProdApiKeyFilter*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/RequestSizeLimitFilter*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/SecurityHeadersFilter*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/Telemetry*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/config/WebConfig*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/explain/LiveRoutingDecisionExplanation*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/explain/LiveRoutingExplanationService*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/explain/RoutingExplanation.class</include>
                        <include>com/richmond423/loadbalancerpro/api/explain/RoutingExplanation$*.class</include>
                        <include>com/richmond423/loadbalancerpro/api/proxy/**</include>
                        <include>com/richmond423/loadbalancerpro/telemetry/**</include>
                        <include>com/richmond423/loadbalancerpro/core/AdaptiveConcurrencyConfig*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/AdaptiveConcurrencyLimiter*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/AutoscalingSignal*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/CanonicalDigest*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/CloudMutationSource*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ConcurrencyFeedback*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ConcurrencyLimitDecision*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ConsistentHashRing*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ConsistentHashRingStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/DomainMetrics*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/FailureScenarioConfig*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/FailureScenarioSignal*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/FailureScenarioType*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/IServerType*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/LatencyWindowSignal*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/LoadSheddingConfig*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/LoadSheddingDecision*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/LoadSheddingPolicy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/LoadSheddingSignal*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/NetworkAwarenessSignal*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/PressureClassifier*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RequestPriority*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoundRobinRoutingStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingDecision*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingDecisionExplanation*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingDecisionFingerprint*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingStrategyId*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingStrategyIdentifier*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/RoutingStrategyRegistry*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ScoreFactorContribution*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ScoreFactorDirection*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ScoreFactorExactness*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/Server.class</include>
                        <include>com/richmond423/loadbalancerpro/core/Server$*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerDegradationState*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerObservation*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerObservationOutcome*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerObservationSource*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerObservationWindowPolicy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerRecommendationScorePolicy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerRollingSignalState*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerScoreBreakdown*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerScoreCalculator*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerSignalConfidence*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerSignalEvidence*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerStateVector*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ServerType*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/ShadowAutoscalerConfig*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/StatefulRoutingStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/TailLatencyPowerOfTwoStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/WeightedLeastConnectionsRoutingStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/WeightedLeastLoadStrategy*.class</include>
                        <include>com/richmond423/loadbalancerpro/core/WeightedRoundRobinRoutingStrategy*.class</include>
                    </includes>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Executable Spring Boot JAR packaging and build metadata. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.richmond423.loadbalancerpro.api.LoadBalancerApiApplication</mainClass>
                    <excludeGroupIds>software.amazon.awssdk,com.google.code.gson,io.projectreactor</excludeGroupIds>
                </configuration>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>repackage</id>
                        <phase>package</phase>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>lab</id>
            <build>
                <finalName>${project.artifactId}-${project.version}-lab</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/*</include>
                            </includes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.richmond423.loadbalancerpro.cli.LabToolsApplication</mainClass>
                            <excludeGroupIds combine.self="override"></excludeGroupIds>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
